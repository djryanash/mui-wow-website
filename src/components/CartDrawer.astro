---
// The cart drawer + its script: ONE shared component for every funnel step
// (rentals, add-ons, donations). Add buttons via data-add-to-cart (+data-cents
// +data-name +data-price) anywhere on the page; the drawer handles edit,
// checkout, the funnel marker, and — when the URL carries an /addons/:ref
// booking chain — the quick-order behavior for beach re-orders.
---

<aside class="cart-drawer" id="cart-drawer" aria-label="Cart"
  data-total="Total" data-checkout-label="Checkout" data-cart-empty="Your cart is empty."
  data-remove-label="Remove" data-checkout-pending="Checkout is not live yet.">
  <div class="cart-head">
    <strong>Cart</strong>
    <button class="cart-close" aria-label="Close">×</button>
  </div>
  <div class="cart-items"></div>
  <p class="cart-empty">Your cart is empty.</p>
  <div class="cart-total">
    <span>Total</span>
    <strong data-cart-total>—</strong>
  </div>
  <button class="btn btn-gold cart-checkout" data-cart-checkout>Checkout</button>
  <p class="cart-note-after" data-checkout-note hidden></p>
</aside>
<button class="cart-fab" aria-label="Cart" data-cart-open hidden>🧺 <span data-cart-badge></span></button>

<script>
  (function () {
    const LOG = (...a) => { try { console.log('%c[Mui WoW cart]', 'color:#f0a500;font-weight:900', ...a); } catch {} };
    window.addEventListener('error', (e) => LOG('WINDOW ERROR', e.message, '@' + e.lineno, e.filename ?? ''));
    window.addEventListener('unhandledrejection', (e) => LOG('UNHANDLED REJECTION', String(e.reason)));
    window.onerror = (msg, src, line) => { document.title = 'ERR: ' + String(msg) + ' @' + line; LOG('WINDOW onerror', msg, '#' + line); };
    try {
      LOG('script start', { ref: location.pathname, userAgent: navigator.userAgent.slice(0, 70), storageTest: 'loading…' });
    } catch (err) {
      console.error('[Mui WoW cart] early error', err);
    }
    // body of the module continues below with detailed logs
    try {
      void 0;
      const chainRef = decodeURIComponent(location.pathname.split('/').filter(Boolean).pop() ?? '').toUpperCase();
      const isChain = /^\/addons\//i.test(location.pathname) && /^[A-Z0-9]{6,16}$/.test(chainRef);

      LOG('storage probe…');
      const memStore = {};
      const memLayer = {
        getItem: (k) => (k in memStore ? memStore[k] : null),
        setItem: (k, v) => { memStore[k] = String(v); },
        removeItem: (k) => { delete memStore[k]; },
      };
      const layer = (name, test) => { try { return test(); } catch (e) { LOG('store layer rejected:', name, e.message); return null; } };

      // localStorage: WRITTEN VALUES MUST ACTUALLY PERSIST (Safari silently
      // discards writes when cookies/site-data are blocked)
      const lsLayer = layer('localStorage', () => {
        localStorage.setItem('__muiwow_t', 'persist-check');
        const persisted = localStorage.getItem('__muiwow_t') === 'persist-check';
        localStorage.removeItem('__muiwow_t');
        if (!persisted) throw new Error('writes are silently discarded');
        return localStorage;
      });

      // cookie layer for browsers that block localStorage but allow cookies
      const cookieLayer = layer('cookie', () => {
        document.cookie = '__muiwow_t=persist-check; path=/; SameSite=Lax';
        const persisted = document.cookie.indexOf('__muiwow_t=persist-check') !== -1;
        document.cookie = '__muiwow_t=; path=/; max-age=0; SameSite=Lax';
        if (!persisted) throw new Error('cookie writes are discarded');
        return {
          getItem: (k) => { const m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)')); return m ? decodeURIComponent(m[1]) : null; },
          setItem: (k, v) => { document.cookie = k + '=' + encodeURIComponent(String(v)) + '; path=/; max-age=1209600; SameSite=Lax'; },
          removeItem: (k) => { document.cookie = k + '=; path=/; max-age=0; SameSite=Lax'; },
        };
      });

      let store; let storeName;
      if (lsLayer) { store = lsLayer; storeName = 'localStorage'; }
      else if (cookieLayer) { store = cookieLayer; storeName = 'cookie (localStorage blocked by your browser)'; }
      else { store = memLayer; storeName = 'memory (all storage blocked — the cart is lost on page navigation)'; }
      LOG('storage layer:', storeName);
      const KEY = 'muiwow-cart';
      const read = () => { try { return JSON.parse(store.getItem(KEY)) ?? {}; } catch { return {}; } };
      const write = (c) => {
        const json = JSON.stringify(c);
        store.setItem(KEY, json);
        const back = store.getItem(KEY);
        LOG('write', { keys: Object.keys(c), written: json, readBack: back, persistedOK: back === json });
        render();
      };

      const drawer = document.getElementById('cart-drawer');
      const badge = document.querySelector('[data-cart-badge]');
      const fab = document.querySelector('[data-cart-open]');
      drawer.querySelector('.cart-checkout').textContent = drawer.dataset.checkoutLabel ?? 'Checkout';

      function render() {
        const cart = read();
        const items = drawer.querySelector('.cart-items');
        items.textContent = '';
        const keys = Object.keys(cart);
        drawer.querySelector('.cart-empty').hidden = keys.length > 0;
        fab.hidden = false;
        const count = Object.values(cart).reduce((a, b) => a + b.qty, 0);
        badge.textContent = count || '';
        let total = 0;
        for (const slug of keys) {
          total += cart[slug].cents * cart[slug].qty;
          const row = document.createElement('div');
          row.className = 'cart-row';
          row.innerHTML = `<div><div class="cart-name">${cart[slug].name}</div><div class="cart-line">${cart[slug].price} × ${cart[slug].qty}</div></div>`;
          const btn = document.createElement('button');
          btn.className = 'cart-remove';
          btn.textContent = drawer.dataset.removeLabel ?? 'Remove';
          btn.onclick = () => { const c = read(); delete c[slug]; write(c); };
          row.appendChild(btn);
          items.appendChild(row);
        }
        drawer.querySelector('[data-cart-total]').textContent = keys.length ? 'HK$' + (total / 100).toLocaleString('en-HK') : '—';
      }

      function openCart() {
        if (!isChain) document.body.dataset.cartStep = '4';
        drawer.classList.add('open');
        render();
      }

      document.addEventListener('click', (e) => {
        LOG('click', { tag: e.target.tagName, cls: String(e.target.className ?? '').slice(0, 50) });
        // click outside an OPEN drawer dismisses it
        if (drawer.classList.contains('open') && !e.target.closest?.('#cart-drawer') && !e.target.closest?.('[data-cart-open]')) {
          drawer.classList.remove('open');
          return;
        }
        if (e.target.closest?.('[data-cart-open]')) { openCart(); return; }
        if (e.target.closest?.('.cart-close')) { drawer.classList.remove('open'); return; }
        const quick = e.target.closest?.('[data-quick-order]');
        if (quick) {
          // Quick-order only exists on a booking chain (the staff-shown menu).
          if (isChain) {
            quick.disabled = true;
            const note = document.getElementById('addons-note');
            fetch('/api/checkout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ slug: quick.dataset.quickOrder, qty: 1 }], ref: chainRef }),
            })
              .then((r) => r.json())
              .then((d) => { if (d.url) location.href = d.url; else throw new Error(d.error ?? 'failed'); })
              .catch((err) => {
                quick.disabled = false;
                if (note) { note.hidden = false; note.textContent = err.message ?? ''; }
              });
            return;
          }
        }
        const add = e.target.closest?.('[data-add-to-cart]');
        if (add) {
          try {
            LOG('ADD to cart', { slug: add.dataset.addToCart, name: add.dataset.name, cents: add.dataset.cents, btnData: JSON.stringify(add.dataset) });
            const c = read();
          const slug = add.dataset.addToCart;
          c[slug] = {
            name: add.dataset.name,
            price: add.dataset.price,
            cents: Number(add.dataset.cents),
            qty: Math.min((c[slug]?.qty ?? 0) + 1, 20),
          };
          write(c);
          LOG('cart after add', read()); // store now contains the item
          render();
          LOG('render done; drawer stays closed for item adds');
          } catch (err) {
            LOG('ADD-ERR', err?.message ?? String(err), err?.stack?.split('\n')[1] ?? '');
            document.title = 'ADD-ERR: ' + (err?.message ?? String(err));
          }
          return;
        }
        const go = e.target.closest?.('[data-cart-checkout]');
        if (go) {
          const cart = read();
          const keys = Object.keys(cart);
          if (!keys.length) return;
          go.disabled = true;
          fetch('/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: keys.map((s) => ({ slug: s, qty: cart[s].qty })) }),
          })
            .then((r) => r.json())
            .then((d) => { if (d.url) location.href = d.url; else throw new Error(d.error ?? 'no url'); })
            .catch(() => {
              const note = drawer.querySelector('[data-checkout-note]');
              note.textContent = drawer.dataset.checkoutPending ?? 'Checkout coming soon.';
              note.hidden = false;
              go.disabled = false;
            });
        }
      });

      // pages that write the cart directly (donation selection) trigger these
      document.addEventListener('muiwow-cart-updated', render);
      document.addEventListener('muiwow-cart-open', openCart);

      render();

      // storage watcher: logs every external mutation of the cart key
      let lastSeen = JSON.stringify(read());
      setInterval(() => {
        let now;
        try { now = store.getItem(KEY); } catch (e) { now = 'STORE ERROR: ' + e.message; }
        if (now !== lastSeen) {
          LOG('STORAGE CHANGED by someone else', { before: lastSeen.slice(0, 120), after: String(now).slice(0, 120) });
          lastSeen = now;
        }
      }, 800);
      LOG('storage watcher on');
      document.title = 'CART-READY';
    } catch (err) {
      document.title = 'INIT-ERR: ' + (err?.message ?? String(err));
    }
  })();
</script>