---
// Site header: brand, nav, language dropdown (hidden when disabled in site.yaml).
// The dropdown is a native <select>: works with zero JS beyond a one-line handler.
import { loadSite, t } from '../data/load.mjs';
import { LOCALES, DEFAULT_LOCALE } from '../data/events.lib.mjs';

const site = loadSite();
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const showPicker =
  site.languagePicker && (site.languages?.es || site.languages?.['zh-hk']);

// Short labels for the dropdown (user-specified: "EN", "ES", "廣東話")
const SHORT: Record<string, string> = { en: 'EN', es: 'ES', 'zh-hk': '廣東話' };

// Current path normalized for dropdown URLs (Layout.astro does the same math).
const raw = Astro.url.pathname.replace(/\/$/, '').replace(/^\/(es|zh-hk)(?=\/|$)/, '') || '/';
const pathFor = (l) => (l === 'en' ? raw : `/${l}${raw}`);
---

<header class="site-header">
  <div class="container">
    <a class="brand-link" href={locale === 'en' ? '/' : `/${locale}/`} aria-label={site.name}>
      <img class="logo" src="/images/brand/mui-wow-logo.png" alt={site.name} />
      <span class="brand-name">{site.name}</span>
    </a>
    <div class="row-2">
      {site.nav.map((item) => (
        <a href={item.href}>{t(item.label, locale)}</a>
      ))}
      {showPicker && (
        <select
          class="lang-select"
          aria-label={t({ en: 'Language', es: 'Idioma', zh: '語言' }, locale)}
          data-current-path={pathFor(locale)}
        >
          {Object.entries(LOCALES)
            .filter(([l]) => l === 'en' || site.languages?.[l])
            .map(([l, info]) => (
              <option value={l} selected={l === locale}>{SHORT[l]}</option>
            ))}
        </select>
      )}
      <button class="header-cart" data-cart-open aria-label={t({ en: 'Cart', es: 'Carrito', zh: '購物車' }, locale)}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span data-cart-badge class="header-cart-badge"></span>
      </button>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll('.lang-select').forEach((el) => {
    (el as HTMLSelectElement).addEventListener('change', (e) => {
      const v = (e.target as HTMLSelectElement).value;
      const base = window.location.pathname.replace(/\/$/, '').replace(/\/(es|zh-hk)(?=\/|$)/, '') || '/';
      const target = v === 'en' ? base : `/${v}${base}`;
      window.location.href = target;
    });
  });
</script>