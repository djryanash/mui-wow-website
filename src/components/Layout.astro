---
// Base HTML wrapper for every page and locale (ADR 0003 locales).
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { loadSite } from '../data/load.mjs';

const site = loadSite();
const { locale = 'en', title, description, ogImage } = Astro.props;

const t = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const tagline = t(site.tagline);

// Locale alternates: rebuild the current path under the other locales.
const normalized = Astro.url.pathname.replace(/\/$/, '').replace(/^\/(es|zh-hk)(?=\/|$)/, '') || '/';
const pathFor = (l) => (l === 'en' ? normalized : `/${l}${normalized}`);
const alternates = ['en', 'es', 'zh-hk'].map((l) => [l, pathFor(l)]);
---

<!doctype html>
<html lang={locale === 'zh-hk' ? 'zh-HK' : locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title && title !== site.name ? `${title} · ${site.name}` : site.name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/images/brand/mui-wow-favicon.png" />
    {alternates.map(([l, href]) => <link rel="alternate" hreflang={l === 'zh-hk' ? 'zh-HK' : l} href={href} />)}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Nunito+Sans:wght@400;700;900&family=Titan+One&family=Pacifico&family=Cormorant+Garamond:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header locale={locale} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>