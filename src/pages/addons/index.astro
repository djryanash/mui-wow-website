---
// Add-on menu: /addons/:ref (rewritten to this page by vercel.json).
// Reached when the customer scans the QR shown on the staff's device.
// Quick-order: each item checks out on its own Stripe session with the
// booking ref attached, so the order joins the chain. Payment returns here.
import Layout from '../../components/Layout.astro';
import { t, loadProducts } from '../../data/load.mjs';
import { chrome, funnel } from '../../data/chrome.mjs';
import FunnelBar from '../../components/FunnelBar.astro';
import CartDrawer from '../../components/CartDrawer.astro';

const locale = Astro.props.locale ?? 'en';
const T = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const addons = loadProducts().filter((p) => p.isAddon && p.orderable);
const title = T(chrome.addonsTitle);
---

<Layout locale={locale} title={title} description={T(chrome.addonsHint)}>
  <FunnelBar step={2} locale={locale} backHref={locale === 'en' ? '/rentals' : `/${locale}/rentals`} backLabel={funnel.rentalsNext} />
  <section class="section">
    <div class="container" style="max-width:760px">
      <p class="kicker">Mui WoW</p>
      <h1>{title}</h1>
      <p class="cart-note">{T(chrome.addonsHint)}</p>
      <div class="cards addons-grid">
        {addons.map((p) => (
          <div class="product-card">
            {p.images?.[0] ? (
              <img class="thumb" src={p.images[0]} alt={T(p.name)} loading="lazy" />
            ) : (
              <div class="fallback-thumb">
                <span style="font-size:2rem">🍺</span>
              </div>
            )}
            <div class="body">
              <h3>{T(p.name)}</h3>
              {p.subtitle && <p class="sub">{T(p.subtitle)}</p>}
              <div class="price-row">
                <span class="price">{p.displayPrice.formatted}</span>
                <button class="btn btn-gold" data-add-to-cart={p.slug} data-name={T(p.name)} data-price={p.displayPrice.formatted} data-cents={p.displayPrice.amount}>
                  {T(chrome.addToCart)} <span class="arrow" aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p id="addons-note" class="flash-error" hidden></p>
      <p class="funnel-next" style="margin-top:30px">
        {locale === 'en' && <a class="btn btn-teal btn-arrow" href="/donations" data-burst>Next: support the events <span class="arrow" aria-hidden="true">→</span></a>}
        {locale === 'es' && <a class="btn btn-teal btn-arrow" href="/es/donations" data-burst>Next: apoya los eventos <span class="arrow" aria-hidden="true">→</span></a>}
        {locale === 'zh-hk' && <a class="btn btn-teal btn-arrow" href="/zh-hk/donations" data-burst>下一步：支持活動 <span class="arrow" aria-hidden="true">→</span></a>}
      </p>
    </div>
  </section>
<CartDrawer />
</Layout>

