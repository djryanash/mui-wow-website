---
// Donations: /donations — support the beach events (fixed tiers).
// Selection model: pick one tier (or "don't donate"), the cart is written
// on selection, and the funnel click-through opens the editable cart.
import Layout from '../components/Layout.astro';
import { loadProducts } from '../data/load.mjs';
import { chrome } from '../data/chrome.mjs';

const locale = Astro.props.locale ?? 'en';
const L = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const tiers = loadProducts().filter((p) => p.kind === 'donation' && p.orderable);
const title = L(chrome.donationsTitle);
---

<Layout locale={locale} title={title} description={L(chrome.donationsHint)}>
  <section class="section">
    <div class="container" style="max-width:760px">
      <p class="kicker">Mui WoW</p>
      <h1>{title}</h1>
      <p class="cart-note">{L(chrome.donationsHint)}</p>

      <div class="donation-row" role="radiogroup" aria-label={title}>
        {tiers.map((p) => (
          <button class="donation-card" data-select-tier={p.slug} data-name={L(p.name)} data-price={p.displayPrice.formatted} data-cents={p.displayPrice.amount} role="radio" aria-checked="false">
            <span class="donation-amount">{p.displayPrice.formatted}</span>
          </button>
        ))}
      </div>

      <p class="funnel-next" style="display:flex; gap:14px; flex-wrap:wrap; margin-top:34px">
        <button class="btn btn-teal btn-arrow" data-add-donation>{L({ en: 'Next: open your cart with this donation', es: 'Next: abre tu carrito con esta donación', zh: '下一步：連同捐贈打開購物車' })} <span class="arrow" aria-hidden="true">→</span></button>
        <button class="btn btn-ghost" data-skip-donation>{L({ en: 'Don't donate', es: 'Sin donación', zh: '唔捐款，跳過' })}</button>
      </p>
      <p id="donate-note" class="cart-note" style="color:var(--gold-bright)">{L({ en: 'Pick an amount above, or continue without one — your call.', es: 'Elige un importe arriba, o continúa sin él — tú decides.', zh: '上方揀一個金額，或者唔捐直接繼續 — 由你話事。' })}</p>

      <!-- The cart drawer (shared with the shop pages) lives here for this page -->
      <aside class="cart-drawer" id="cart-drawer" aria-label={L(chrome.cart)}
        data-total={L(chrome.total)}
        data-checkout-label={L(chrome.checkout)}
        data-cart-empty={L(chrome.cartEmpty)}
        data-remove-label={L(chrome.remove)}
        data-checkout-pending={L(chrome.checkoutPending)}>
        <div class="cart-head">
          <strong>{L(chrome.cart)}</strong>
          <button class="cart-close" aria-label="Close">×</button>
        </div>
        <div class="cart-items"></div>
        <p class="cart-empty">{L(chrome.cartEmpty)}</p>
        <div class="cart-total">
          <span>{L(chrome.total)}</span>
          <strong data-cart-total>—</strong>
        </div>
        <button class="btn btn-gold cart-checkout" data-cart-checkout>{L(chrome.checkout)}</button>
        <p class="cart-note-after" data-checkout-note hidden></p>
      </aside>
      <button class="cart-fab" aria-label={L(chrome.cart)} data-cart-open hidden>🧺 <span data-cart-badge></span></button>
    </div>
  </section>
</Layout>

<script>
  (function () {
    const KEY = 'muiwow-cart';
    const read = () => { try { return JSON.parse(localStorage.getItem(KEY)) ?? {}; } catch { return {}; } };
    const write = (c) => { localStorage.setItem(KEY, JSON.stringify(c)); render(); };
    const DONATION_SLUGS = new Set('""" + JSON.stringify(tiers.map((p) => p.slug)) + """'.split(','));

    const drawer = document.getElementById('cart-drawer');
    drawer.querySelector('.cart-checkout').textContent = drawer.dataset.checkoutLabel ?? 'Checkout';

    function render() {
      const cart = read();
      const items = drawer.querySelector('.cart-items');
      items.textContent = '';
      const slugs = Object.keys(cart);
      drawer.querySelector('.cart-empty').hidden = slugs.length > 0;
      document.querySelector('[data-cart-open]').hidden = false;
      const count = Object.values(cart).reduce((a, b) => a + b.qty, 0);
      drawer.querySelector('[data-cart-badge]').textContent = count || '';
      let total = 0;
      for (const slug of slugs) {
        total += cart[slug].cents * cart[slug].qty;
        const row = document.createElement('div');
        row.className = 'cart-row';
        row.innerHTML = `<div><div class="cart-name">${cart[slug].name}</div><div class="cart-line">${cart[slug].price} × ${cart[slug].qty}</div></div>`;
        const btn = document.createElement('button');
        btn.className = 'cart-remove';
        btn.textContent = drawer.dataset.removeLabel ?? 'Remove';
        btn.onclick = () => { const c = read(); delete c[slug]; write(c); };
        row.appendChild(btn);
        items.appendChild(row);
      }
      drawer.querySelector('[data-cart-total]').textContent = slugs.length ? 'HK$' + (total / 100).toLocaleString('en-HK') : '—';
      // selection state on the tier cards
      const selected = slugs.find((s) => DONATION_SLUGS.has(s));
      document.querySelectorAll('[data-select-tier]').forEach((card) => {
        card.setAttribute('aria-checked', card.dataset.selectTier === selected ? 'true' : 'false');
        card.classList.toggle('selected', card.dataset.selectTier === selected);
      });
    }

    function clearDonations() {
      const c = read();
      for (const s of Object.keys(c)) if (DONATION_SLUGS.has(s)) delete c[s];
      write(c);
    }

    function openCartWithDonation(slug) {
      const card = document.querySelector(`[data-select-tier="${slug}"]`);
      clearDonations();
      const c = read();
      c[slug] = { name: card.dataset.name, price: card.dataset.price, cents: Number(card.dataset.cents), qty: 1 };
      write(c);
      drawer.classList.add('open');
      drawer.querySelector('.cart-items').scrollIntoView({ block: 'nearest' });
    }

    document.addEventListener('click', (e) => {
      const tier = e.target.closest?.('[data-select-tier]');
      if (tier) {
        const already = read()[tier.dataset.selectTier]?.qty === 1;
        if (already) { clearDonations(); render(); return; } // second tap = unselect
        openCartWithDonation(tier.dataset.selectTier);
        return;
      }
      const add = e.target.closest?.('[data-add-donation]');
      if (add) {
        const selected = Object.keys(read()).find((s) => DONATION_SLUGS.has(s));
        if (selected) openCartWithDonation(selected);
        else drawer.classList.add('open'); // nothing selected: open the cart anyway
        return;
      }
      const skip = e.target.closest?.('[data-skip-donation]');
      if (skip) { clearDonations(); drawer.classList.add('open'); return; }
      if (e.target.closest?.('[data-cart-open]')) { drawer.classList.add('open'); render(); return; }
      if (e.target.closest?.('.cart-close')) { drawer.classList.remove('open'); return; }
      const go = e.target.closest?.('[data-cart-checkout]');
      if (go) {
        const cart = read();
        const slugs = Object.keys(cart);
        if (!slugs.length) return;
        go.disabled = true;
        fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: slugs.map((s) => ({ slug: s, qty: cart[s].qty })) }),
        })
          .then((r) => r.json())
          .then((d) => { if (d.url) location.href = d.url; else throw new Error(d.error ?? 'no url'); })
          .catch(() => {
            const note = drawer.querySelector('[data-checkout-note]');
            note.textContent = drawer.dataset.checkoutPending ?? 'Checkout coming soon.';
            note.hidden = false;
            go.disabled = false;
          });
      }
    });

    render();
  })();
</script>