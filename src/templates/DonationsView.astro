---
// Donations: /donations — support the beach events (fixed tiers).
// Selection model: pick one tier (or the HK$0 opt-out); the cart is written
// on selection and the drawer opens over the page. One donation max.
import Layout from '../components/Layout.astro';
import { loadProducts } from '../data/load.mjs';
import { chrome, funnel } from '../data/chrome.mjs';
import FunnelBar from '../components/FunnelBar.astro';
import CartDrawer from '../components/CartDrawer.astro';

const locale = Astro.props.locale ?? 'en';
const L = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const tiers = loadProducts().filter((p) => p.kind === 'donation');
const title = L(chrome.donationsTitle);
---

<Layout locale={locale} title={title} description={L(chrome.donationsHint)}>
  <FunnelBar step={3} locale={locale} backHref={locale === 'en' ? '/addons' : `/${locale}/addons`} backLabel={funnel.addonsNext} data-funnel-cart />
  <section class="section">
    <div class="container" style="max-width:760px">
      <h1>{title}</h1>
      <p class="cart-note">{L(chrome.donationsHint)}</p>
      <p id="donate-hint" class="cart-note" style="color:var(--gold-bright)"></p>

      <div class="donation-row" role="radiogroup" aria-label={title}>
        {tiers.map((p) => (
          <button class="donation-card" data-select-tier={p.slug} data-name={L(p.name)} data-price={p.displayPrice.formatted} data-cents={p.displayPrice.amount} role="radio" aria-checked="false">
            <span class="donation-amount">{p.displayPrice.formatted}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <CartDrawer />
</Layout>
<script>
  (function () {
    const DONATION_SLUGS = ["support-0", "support-5", "support-10", "support-20", "support-50", "support-100", "support-200", "support-500"];
    const layer = (name, test) => { try { return test(); } catch (e) { return null; } };
    let store; let storeName;
    try {
      localStorage.setItem('__muiwow_t', 'p');
      store = store && store.getItem && localStorage.getItem('__muiwow_t') === 'p' ? localStorage : null;
      localStorage.removeItem('__muiwow_t');
    } catch { store = null; }
    if (!store && typeof document !== 'undefined') {
      try {
        document.cookie = '__muiwow_t=p; path=/; SameSite=Lax';
        if (document.cookie.indexOf('__muiwow_t=p') !== -1) {
          document.cookie = '__muiwow_t=; path=/; max-age=0; SameSite=Lax';
          store = {
            getItem: (k) => { const m = document.cookie.match(new RegExp('(?:^|; )' + k + '=([^;]*)')); return m ? decodeURIComponent(m[1]) : null; },
            setItem: (k, v) => { document.cookie = k + '=' + encodeURIComponent(String(v)) + '; path=/; max-age=1209600; SameSite=Lax'; },
            removeItem: (k) => { document.cookie = k + '=; path=/; max-age=0; SameSite=Lax'; },
          };
        }
      } catch { store = null; }
    }
    if (!store) {
      const mem = {};
      store = { getItem: (k) => (k in mem ? mem[k] : null), setItem: (k, v) => { mem[k] = String(v); }, removeItem: (k) => { delete mem[k]; } };
    };
    const KEY = 'muiwow-cart';
    const read = () => { try { return JSON.parse(store.getItem(KEY)) ?? {}; } catch { return {}; } };
    const write = (c) => { store.setItem(KEY, JSON.stringify(c)); document.dispatchEvent(new CustomEvent('muiwow-cart-updated')); };

    function paintSelection() {
      const cart = read();
      const selected = Object.keys(cart).find((s) => DONATION_SLUGS.includes(s) && s !== 'support-0');
      document.querySelectorAll('[data-select-tier]').forEach((card) => {
        card.setAttribute('aria-checked', card.dataset.selectTier === selected ? 'true' : 'false');
        card.classList.toggle('selected', card.dataset.selectTier === selected);
      });
    }

    document.addEventListener('click', (e) => {
      const tier = e.target.closest?.('[data-select-tier]');
      if (tier) {
        // HK$0 is the explicit opt-out: clears any donation, nothing added.
        if (tier.dataset.selectTier === 'support-0') {
          const c = read();
          for (const s of Object.keys(c)) if (DONATION_SLUGS.includes(s)) delete c[s];
          write(c);
          document.dispatchEvent(new CustomEvent('muiwow-cart-open'));
          return;
        }
        const c = read();
        for (const s of Object.keys(c)) if (DONATION_SLUGS.includes(s) && s !== tier.dataset.selectTier) delete c[s];
        c[tier.dataset.selectTier] = {
          name: tier.dataset.name,
          price: tier.dataset.price,
          cents: Number(tier.dataset.cents),
          qty: 1,
        };
        write(c);
        document.dispatchEvent(new CustomEvent('muiwow-cart-open'));
        return;
      }
    });

    document.addEventListener('muiwow-cart-updated', paintSelection);
    paintSelection();
  })();
</script>