---
// Donations: /donations — support the beach events (fixed tiers).
// Selection model: pick one tier (or the HK$0 opt-out); the cart is written
// on selection and the drawer opens over the page. One donation max.
import Layout from '../components/Layout.astro';
import { loadProducts } from '../data/load.mjs';
import { chrome, funnel } from '../data/chrome.mjs';
import FunnelBar from '../components/FunnelBar.astro';
import CartDrawer from '../components/CartDrawer.astro';

const locale = Astro.props.locale ?? 'en';
const L = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const tiers = loadProducts().filter((p) => p.kind === 'donation');
const title = L(chrome.donationsTitle);
---

<Layout locale={locale} title={title} description={L(chrome.donationsHint)}>
  <FunnelBar step={3} locale={locale} backHref={locale === 'en' ? '/addons' : `/${locale}/addons`} backLabel={funnel.addonsNext} data-funnel-cart />
  <section class="section">
    <div class="container" style="max-width:760px">
      <h1>{title}</h1>
      <p class="cart-note">{L(chrome.donationsHint)}</p>
      <p id="donate-hint" class="cart-note" style="color:var(--gold-bright)"></p>

      <div class="donation-row" role="radiogroup" aria-label={title}>
        {tiers.map((p) => (
          <button class="donation-card" data-select-tier={p.slug} data-name={L(p.name)} data-price={p.displayPrice.formatted} data-cents={p.displayPrice.amount} role="radio" aria-checked="false">
            <span class="donation-amount">{p.displayPrice.formatted}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <CartDrawer />
</Layout>
<script>
  (function () {
    function paintSelection() {
      document.querySelectorAll('[data-select-tier]').forEach((card) => {
        const selected = document.querySelector('[aria-current="donation"]')?.dataset.selectTier;
        card.setAttribute('aria-checked', card.dataset.selectTier === selected ? 'true' : 'false');
        card.classList.toggle('selected', card.dataset.selectTier === selected);
      });
    }

    document.addEventListener('click', (e) => {
      const tier = e.target.closest?.('[data-select-tier]');
      if (!tier) return;
      // announce the selection: the shared cart drawer owns the storage and
      // performs the write, then opens itself (the single-writer contract).
      document.dispatchEvent(new CustomEvent('muiwow-donation-select', {
        detail: {
          slug: tier.dataset.selectTier,
          name: tier.dataset.name,
          price: tier.dataset.price,
          cents: Number(tier.dataset.cents),
        },
      }));
    });

    document.addEventListener('muiwow-cart-updated', paintSelection);
    paintSelection();
  })();
</script>