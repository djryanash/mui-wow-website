---
import Layout from '../components/Layout.astro';
import { loadProducts } from '../data/load.mjs';
import { chrome } from '../data/chrome.mjs';
import { t } from '../data/load.mjs';

const locale = Astro.props.locale ?? 'en';
const T = (v) => (v && typeof v === 'object' ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const copy = {
  title: { en: 'Thank you — see you at the beach!', es: '¡Gracias — te esperamos en la playa!', zh: '多謝你 — 沙灘見！' },
  body: {
    en: 'Your booking is confirmed. A confirmation email with your QR code is on its way — show it at the beach and we hand over your items.',
    es: 'Tu reserva está confirmada. Te llega un email con tu código QR — muéstralo en la playa y te entregamos tus artículos.',
    zh: '你嘅預訂已確認。確認電郵連 QR 二維碼正在路上 — 到沙灘時出示，我哋即刻交貨俾你。',
  },
  back: { en: '← Back to rentals', es: '← Volver a alquileres', zh: '← 返回租賃' },
  orderNow: { en: 'Order', es: 'Pedir', zh: '落單' },
};
---

<Layout locale={locale} title={T(copy.title)} description={T(copy.body)}>
  <section class="coming-soon">
    <div class="container">
      <img src="/images/brand/mui-wow-logo.png" alt="Mui WoW" style="height:100px; margin:0 auto 18px;" />
      <h1>{T(copy.title)}</h1>
      <p style="max-width:52ch; margin:14px auto">{T(copy.body)}</p>
      <div id="thanks-qr" class="qr-frame" style="margin:6px auto 0; width:240px; background:#fff; border-radius:12px; padding:12px; box-shadow:var(--shadow); display:none"></div>
      <p id="thanks-ref" style="font-weight:900; color:var(--gold-bright); margin-top:10px"></p>
      <p id="thanks-qr-hint" style="max-width:52ch; margin:0 auto; color:var(--turquoise)"></p>
      <div class="info-block" style="margin-top:34px; text-align:left">
        <h2>{T(chrome.addonsTitle)}</h2>
        <p class="cart-note">{T(chrome.addonsHint)}</p>
        <div class="cards" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr))">
          {loadProducts().filter((p) => p.isAddon && p.orderable).map((p) => (
            <div class="product-card">
              <div class="body">
                <h3>{T(p.name)}</h3>
                <div class="price-row">
                  <span class="price">{p.displayPrice.formatted}</span>
                  <button class="btn btn-gold" data-quick-order={p.slug} data-price={p.displayPrice.formatted}>{T(chrome.quickOrder)} <span class="arrow" aria-hidden="true">→</span></button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <p id="thanks-note" class="flash-error" hidden></p>
      <p style="margin-top:26px"><a href="/rentals">{T(copy.back)}</a></p>
    </div>
  </section>
</Layout>
<script src="/js/qrcode.min.js" is:inline></script>
<script>
  (function () {
    const lang = document.documentElement.getAttribute('lang');
    document.addEventListener('click', (e) => {
      const btn = e.target.closest?.('[data-quick-order]');
      if (!btn) return;
      btn.disabled = true;
      const note = document.getElementById('thanks-note');
      fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ slug: btn.dataset.quickOrder, qty: 1 }] }),
      })
        .then((r) => r.json())
        .then((d) => { if (d.url) location.href = d.url; else throw new Error(d.error ?? 'failed'); })
        .catch((err) => {
          btn.disabled = false;
          note.hidden = false;
          note.textContent = (lang === 'es' ? 'Todavía no: ' : lang === 'zh-hk' ? '暫時未能：' : 'Not ready yet: ') + (err.message ?? '');
        });
    });
  // QR on the thank-you page: the booking comes back by session id.
  const sid = new URLSearchParams(location.search).get('session_id');
  if (sid) {
    fetch(`/api/booking?session_id=${encodeURIComponent(sid)}`)
      .then((r) => r.json())
      .then((b) => {
        if (b.error) return;
        const el = document.getElementById('thanks-qr');
        el.style.display = 'block';
        if (b.qr && window.QRCode) QRCode.toCanvas(el, b.qr, { width: 216 });
        document.getElementById('thanks-ref').textContent = b.ref ?? '';
        const hint = document.getElementById('thanks-qr-hint');
        hint.textContent = (lang === 'es' ? 'Muéstrale este código a nuestro equipo en la playa — lo escanean y se confirma la entrega.' : lang === 'zh-hk' ? '喺沙灘俾員工掃描呢個碼確認交收。' : 'Show this code to our team at the beach — they scan it and the hand-over is confirmed.');
      });
  }
  })();
</script>