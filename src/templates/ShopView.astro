---
// Rentals & Supplies: the shop. Grid of products + cart drawer (localStorage).
// Coming-soon state only when the catalogue is empty.
import Layout from '../components/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CartDrawer from '../components/CartDrawer.astro';
import FunnelBar from '../components/FunnelBar.astro';
import { loadProducts, loadSite } from '../data/load.mjs';
import { chrome, funnel } from '../data/chrome.mjs';

const site = loadSite();
const locale = Astro.props.locale ?? 'en';
const T = (v) => (typeof v === 'object' && v ? v[locale === 'zh-hk' ? 'zh' : locale] ?? v.en : v);
const products = loadProducts().filter((p) => p.kind !== 'donation' && !p.isAddon && !p.isTicket);
---

<Layout locale={locale} title={T(chrome.shopTitle)} description={T(chrome.shopTitle)}>
  <FunnelBar step={1} locale={locale} />
  <section class="section">
    <div class="container">
      <p class="kicker">Mui WoW</p>
      <h1>{T(chrome.shopTitle)}</h1>

      {products.length === 0 ? (
        <p style="max-width:56ch">{T(chrome.comingSoonBody)}</p>
      ) : (
        <>
          <p class="cart-note">{T({ en: 'Pick up everything at the beach on the day.', es: 'Recógelo todo en la playa el día del evento.', zh: '活動當日喺沙灘自取。' })}</p>
          <div class="cards">
            {products.map((p) => <ProductCard product={p} locale={locale} />)}
          </div>
          {products.length > 0 && (
            <p class="funnel-next" style="margin-top:26px">
              {locale === 'en' ? <a class="btn btn-teal btn-arrow" href="/addons" data-burst>Next: drinks &amp; snacks <span class="arrow" aria-hidden="true">→</span></a> : ''}
              {locale === 'es' && <a class="btn btn-teal btn-arrow" href="/es/addons" data-burst>Next: bebidas y snacks <span class="arrow" aria-hidden="true">→</span></a>}
              {locale === 'zh-hk' && <a class="btn btn-teal btn-arrow" href="/zh-hk/addons" data-burst>下一步：飲品小食 <span class="arrow" aria-hidden="true">→</span></a>}
            </p>
          )}
        </>
      )}
    </div>
  </section>

  <!-- Cart drawer -->
  <CartDrawer />
</Layout>